{
    "name": "aaieduhr/heartphrame-module-comment",
    "description": "Document comments, reactions, moderation, and reports for HeartPhrame HTML documents.",
    "type": "heartphrame-module",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-orm.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-html-editor.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-notification.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "aaieduhr/heartphrame-framework": "dev-main",
        "aaieduhr/heartphrame-module-auth": "dev-main",
        "aaieduhr/heartphrame-module-editor-html": "dev-main",
        "aaieduhr/heartphrame-module-notification": "dev-main",
        "aaieduhr/heartphrame-module-orm": "dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10 || ^11",
        "rector/rector": "^2.0",
        "slevomat/coding-standard": "^8",
        "squizlabs/php_codesniffer": "^3"
    },
    "suggest": {
        "aaieduhr/heartphrame-module-backup": "Adds backup and restore for comments, reactions, reports, and settings.",
        "aaieduhr/heartphrame-module-theme": "Provides configured light and dark visual tokens.",
        "aaieduhr/heartphrame-module-workspace": "Applies inherited Workspace read and publish permissions to comments."
    },
    "autoload": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleComment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleComment\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Srce",
            "email": "aai@srce.hr"
        }
    ],
    "config": {
        "github-protocols": [
            "https"
        ],
        "use-github-api": false,
        "sort-packages": true,
        "cache-dir": "build/composer",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "composer-runtime-api": "^2.1"
    },
    "scripts": {
        "pre-commit": [
            "vendor/bin/phpcbf",
            "vendor/bin/rector --clear-cache",
            "vendor/bin/phpcs -p",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ],
        "on-commit": [
            "vendor/bin/phpcs -p",
            "vendor/bin/rector --dry-run --clear-cache",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ]
    }
}
